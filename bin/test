#!/bin/zsh
# Fixture tests for hd and hdp: both scripts run against tests/fixtures through a fake hc,
# the output is diffed against tests/expected/. No Alfred, no Herdr, no network.
set -u
cd "${0:A:h}/.."
repo=$PWD
icons=$repo/workflow/icons
fake=$repo/tests/fake-hc
hc_fail="herdr: no running core"

# A fake home keeps the recorded rows stable and exercises the "~" shortening.
home=/Users/test
export HOME=$home

# Ages in subtitles are measured from a fixed "now" so the recorded rows stay stable.
export HERDR_NOW_MS=1795364000000

failed=0
total=0

check() { # check <case> <fixture file|fail|rpc-error> <query> <hd|hdp>
  local case=$1 fixture=$2 query=$3 which=$4 out want
  local expected=tests/expected/$case.$which.json
  local -a env_vars
  (( total++ ))

  case $fixture in
    fail) env_vars=(HC=$fake HC_FAIL=$hc_fail) ;;
    rpc-error) env_vars=(HC=$fake HC_RPC_ERROR=1) ;;
    *) env_vars=(HC=$fake HC_FIXTURE=$repo/tests/fixtures/$fixture) ;;
  esac

  if [[ $which == hd ]]; then
    out=$(env $env_vars /bin/zsh workflow/scripts/agents.sh "$query")
  else
    out=$(env $env_vars /bin/zsh workflow/panel.alfredui/scripts/pulse)
  fi

  # The panel's icons are absolute; record and compare them as @ICONS@.
  out=${out//$icons/@ICONS@}
  want=$(<$expected)

  if [[ $out == "$want" ]]; then
    print -r -- "ok   $case.$which"
    return 0
  fi

  print -r -- "FAIL $case.$which"
  if [[ $want == \{* && $out == \{* ]]; then
    diff -u <(print -r -- $want | jq .) <(print -r -- $out | jq .) | sed 's/^/     /'
  else
    diff -u <(print -r -- $want) <(print -r -- $out) | sed 's/^/     /'
  fi
  (( failed++ ))
}

check mixed mixed.json "" hd
check mixed mixed.json "" hdp
check mixed-query mixed.json "api blocked" hd
check attention attention.json "" hd
check attention attention.json "" hdp
check idle-turns idle-turns.json "" hd
check empty empty.json "" hd
check empty empty.json "" hdp
check fail fail "" hd
check fail fail "" hdp
check rpc-error rpc-error "" hd
check rpc-error rpc-error "" hdp

# hdn: the most urgent agent in one row, skipping what the Herdr tab already shows.
fake_app=$repo/tests/fake-herdr-app
fake_focus=$repo/tests/fake-focus
fake_show=$repo/tests/fake-notify-show

hdn_env() { # hdn_env <fixture file|fail|rpc-error> <herdr-app ls file|fail|->
  local fixture=$1 ls=$2
  hdn_vars=()
  case $fixture in
    fail) hdn_vars=(HC=$fake HC_FAIL=$hc_fail) ;;
    rpc-error) hdn_vars=(HC=$fake HC_RPC_ERROR=1) ;;
    *) hdn_vars=(HC=$fake HC_FIXTURE=$repo/tests/fixtures/$fixture) ;;
  esac
  case $ls in
    fail) hdn_vars+=("HERDR_LS_FAIL=1") ;;
    -) ;;
    *) hdn_vars+=("HERDR_LS=$repo/tests/fixtures/$ls") ;;
  esac
  hdn_vars+=("HERDR_APP=$fake_app")
  hdn_vars+=("HERDR_FRONT_CMD=print -r -- ${HDN_FRONT:-dev.herdr.app}")
}

check_hdn() { # check_hdn <case> <fixture file|fail|rpc-error> <herdr-app ls file|fail|->
  local case=$1 out want
  local expected=tests/expected/$case.hdn.json
  (( total++ ))
  hdn_env "$2" "$3"

  out=$(env $hdn_vars /bin/zsh workflow/scripts/next.sh)
  want=$(<$expected)

  if [[ $out == "$want" ]]; then
    print -r -- "ok   $case.hdn"
    return 0
  fi

  print -r -- "FAIL $case.hdn"
  diff -u <(print -r -- $want | jq .) <(print -r -- $out | jq .) | sed 's/^/     /'
  (( failed++ ))
}

check_jump() { # check_jump <case> <fixture file|fail|rpc-error> <herdr-app ls file|->
  local case=$1 out want rc=0
  local expected=tests/expected/jump-$case.log
  local focus_log=$repo/build/jump-$case.focus.log show_log=$repo/build/jump-$case.show.log
  (( total++ ))
  hdn_env "$2" "$3"
  mkdir -p $repo/build
  : > $focus_log
  : > $show_log

  env $hdn_vars FOCUS_CMD=$fake_focus NOTIFY_SHOW_CMD=$fake_show \
      FOCUS_LOG=$focus_log NOTIFY_SHOW_LOG=$show_log \
      /bin/zsh workflow/scripts/next.sh --jump || rc=$?

  if (( rc != 0 )); then
    print -r -- "FAIL jump.$case (next.sh exited $rc)"
    (( failed++ ))
    return 1
  fi

  out=$( { sed 's/^/focus: /' $focus_log; sed 's/^/notify: /' $show_log } )
  want=$(<$expected)

  if [[ $out == "$want" ]]; then
    print -r -- "ok   jump.$case"
    return 0
  fi

  print -r -- "FAIL jump.$case"
  diff -u <(print -r -- "$want") <(print -r -- "$out") | sed 's/^/     /'
  (( failed++ ))
}

# hdr: pick an agent, type a follow-up, and send it with ⌘↩.
screens=$repo/tests/fixtures/screens

check_hdr() { # check_hdr <case> <fixture file|fail|rpc-error> <query>
  local case=$1 fixture=$2 query=$3 out want
  local expected=tests/expected/$case.hdr.json
  local -a env_vars
  (( total++ ))

  case $fixture in
    fail) env_vars=(HC=$fake HC_FAIL=$hc_fail) ;;
    rpc-error) env_vars=(HC=$fake HC_RPC_ERROR=1) ;;
    *) env_vars=(HC=$fake HC_FIXTURE=$repo/tests/fixtures/$fixture) ;;
  esac

  out=$(env $env_vars HC_READ_DIR=$screens /bin/zsh workflow/scripts/reply.sh "$query")
  want=$(<$expected)

  if [[ $out == "$want" ]]; then
    print -r -- "ok   $case.hdr"
    return 0
  fi

  print -r -- "FAIL $case.hdr"
  diff -u <(print -r -- $want | jq .) <(print -r -- $out | jq .) | sed 's/^/     /'
  (( failed++ ))
}

check_send() { # check_send <case> <address> <name> <text> <want rc> [HC_SEND_FAIL]
  local case=$1 addr=$2 name=$3 text=$4 wantrc=$5 sendfail=${6:-} out want rc=0
  local expected=tests/expected/$case.send.log
  local send_log=$repo/build/send-$case.send.log show_log=$repo/build/send-$case.show.log
  (( total++ ))
  mkdir -p $repo/build
  : > $send_log
  : > $show_log

  env HC=$fake HC_SEND_LOG=$send_log HC_SEND_FAIL=$sendfail \
      NOTIFY_SHOW_CMD=$fake_show NOTIFY_SHOW_LOG=$show_log \
      reply_text="$text" reply_name="$name" \
      /bin/zsh workflow/scripts/send.sh "$addr" || rc=$?

  out=$( { sed 's/^/send: /' $send_log; sed 's/^/notify: /' $show_log } )
  want=$(<$expected)

  if (( rc == wantrc )) && [[ $out == "$want" ]]; then
    print -r -- "ok   send.$case"
    return 0
  fi

  print -r -- "FAIL send.$case (exit $rc, want $wantrc)"
  diff -u <(print -r -- "$want") <(print -r -- "$out") | sed 's/^/     /'
  (( failed++ ))
}

check_hdn queue queue.json -
check_hdn idle-turns idle-turns.json -
check_hdn done queue-done.json -
check_hdn tab queue.json ls-tab-blocked.json
check_hdn subagent queue.json ls-tab-subagent.json
check_hdn tab-all queue.json ls-tab-all.json
HDN_FRONT=com.example.other check_hdn background queue.json ls-tab-all.json
check_hdn empty empty.json -
check_hdn ls-fail queue.json fail
check_hdn fail fail -
check_hdn rpc-error rpc-error -

check_jump target queue.json -
check_jump tab queue.json ls-tab-blocked.json
check_jump none empty.json -
check_jump tab-all queue.json ls-tab-all.json
HDN_FRONT=com.example.other check_jump background queue.json ls-tab-all.json
check_jump core-down fail -

check_hdr pick reply-pick.json ""
check_hdr pick-query reply-pick.json "main"
check_hdr nomatch reply-pick.json "zzz"
check_hdr reply reply.json "dev > check the log and rerun the entire suite with verbose output once"
check_hdr reply-empty reply.json "dev >"
check_hdr reply-empty-space reply.json "dev > "
check_hdr reply-again reply.json "dev > a > b"
check_hdr reply-many reply-many.json "batch > go"
check_hdr reply-nomatch reply.json "zzz > hi"
check_hdr fail fail "dev > hi"
check_hdr rpc-error rpc-error "dev > hi"

check_send sent r-done fresh-done 'say "hi" $HOME `x` -n' 0
check_send not-sent r-blocked gate-check "hi" 1 "agent is blocked"
check_send nothing r-done fresh-done "" 0

# The watcher: one `hc events` stream from tests/fixtures/events-*.jsonl through a fake notify
# that records every banner, diffed against the recorded arguments.
fake_notify=$repo/tests/fake-notify
focus_sh=$repo/workflow/scripts/focus.sh

check_notify() { # check_notify <case> <events fixture> <bundle id in front> [seconds between lines]
  local case=$1 fixture=$2 front=$3 delay=${4:-} out want rc=0
  local expected=tests/expected/notify-$case.log
  (( total++ ))
  mkdir -p $repo/build
  : > $repo/build/notify-$case.log

  env HC=$fake HC_EVENTS=$repo/tests/fixtures/$fixture HC_EVENTS_DELAY=$delay \
      NOTIFY_LOG=$repo/build/notify-$case.log NOTIFY_CMD=$fake_notify \
      HERDR_FRONT_CMD="print -r -- $front" WATCH_ONCE=1 \
      /bin/zsh workflow/scripts/watch || rc=$?

  if (( rc != 0 )); then
    print -r -- "FAIL notify.$case (watch exited $rc)"
    (( failed++ ))
    return 1
  fi

  out=$(<$repo/build/notify-$case.log)
  out=${out//$focus_sh/@FOCUS@}
  want=$(<$expected)

  if [[ $out == "$want" ]]; then
    print -r -- "ok   notify.$case"
    return 0
  fi

  print -r -- "FAIL notify.$case"
  diff -u <(print -r -- "$want") <(print -r -- "$out") | sed 's/^/     /'
  (( failed++ ))
}

check_notify done events-done.jsonl com.example.other
check_notify idle events-idle.jsonl com.example.other
check_notify idle-quiet events-idle-quiet.jsonl com.example.other
check_notify repeat events-repeat.jsonl com.example.other
check_notify shell events-shell.jsonl com.example.other
check_notify unknown events-unknown.jsonl com.example.other
check_notify snapshot events-snapshot.jsonl com.example.other
check_notify batch events-batch.jsonl com.example.other
check_notify spaced events-batch.jsonl com.example.other 2
check_notify quoted events-quoted.jsonl com.example.other
check_notify front events-done.jsonl dev.herdr.app
check_notify noise events-noise.jsonl com.example.other

# A post that fails must be reported on stderr and must not end the watcher.
(( total++ ))
: > $repo/build/notify-failpost.log
: > $repo/build/notify-failpost.err
rc=0
env HC=$fake HC_EVENTS=$repo/tests/fixtures/events-done.jsonl \
    NOTIFY_LOG=$repo/build/notify-failpost.log NOTIFY_CMD=$repo/tests/fail-notify \
    HERDR_FRONT_CMD="print -r -- com.example.other" WATCH_ONCE=1 \
    /bin/zsh workflow/scripts/watch 2>$repo/build/notify-failpost.err || rc=$?
if (( rc == 0 )) && grep -q 'post failed' $repo/build/notify-failpost.err; then
  print -r -- "ok   notify.failpost"
else
  print -r -- "FAIL notify.failpost (exit $rc)"
  sed 's/^/     /' $repo/build/notify-failpost.err
  (( failed++ ))
fi

# The install script's generation step, without launchctl.
(( total++ ))
if out=$({ staged=$(bin/stage-notifier build/runtime) &&
            bin/make-watch-plist build/watch-launchagent.plist "$staged"; } 2>&1) &&
   [[ $(plutil -extract ProgramArguments json -o - build/watch-launchagent.plist | jq -c .) ==
      "[\"/bin/zsh\",\"$repo/build/runtime/workflow/scripts/watch\"]" ]] &&
   cmp -s workflow/scripts/focus.sh build/runtime/workflow/scripts/focus.sh &&
   cmp -s workflow/lib/notify.jq build/runtime/workflow/lib/notify.jq &&
   cmp -s workflow/lib/notify.zsh build/runtime/workflow/lib/notify.zsh &&
   ! bin/stage-notifier "$HOME/Documents/alfred-herdr-test" 2>/dev/null &&
   [[ ! -e $HOME/Documents/alfred-herdr-test ]]; then
  print -r -- "ok   notifier.launchagent"
else
  print -r -- "FAIL notifier.launchagent"
  print -r -- "$out" | sed 's/^/     /'
  (( failed++ ))
fi

if (( $+commands[swiftc] )); then
  (( total++ ))
  if out=$(swiftc -typecheck notifier/HerdrNotify.swift 2>&1); then
    print -r -- "ok   notifier.typecheck"
  else
    print -r -- "FAIL notifier.typecheck"
    print -r -- "$out" | sed 's/^/     /'
    (( failed++ ))
  fi
fi

if (( failed > 0 )); then
  print -r -- "$failed of $total cases failed"
  exit 1
fi
