#!/bin/zsh
# Copy the watcher's runtime to $1 (default ~/Library/Application Support/alfred-herdr) and print
# the staged watch path. launchd cannot read ~/Documents, ~/Desktop or ~/Downloads (#17).
set -eu
cd "${0:A:h}/.."

dest=${1:-$HOME/Library/Application Support/alfred-herdr}
dest=${dest:A}
for blocked in Documents Desktop Downloads; do
  if [[ $dest == $HOME/$blocked || $dest == $HOME/$blocked/* ]]; then
    print -r -- "stage-notifier: launchd cannot read $dest; pick a path outside ~/$blocked" >&2
    exit 1
  fi
done

mkdir -p "$dest/workflow/scripts" "$dest/workflow/lib"
cp -p workflow/scripts/watch workflow/scripts/focus.sh "$dest/workflow/scripts/"
cp -p workflow/lib/*.jq "$dest/workflow/lib/"

print -r -- "$dest/workflow/scripts/watch"
