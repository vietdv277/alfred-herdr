#!/bin/sh
# Stand-in for `hc` in bin/test: answers `connect` with the fixture in $HC_FIXTURE as the
# terminal.list result, fails with the message in $HC_FAIL so the "Herdr core is not running"
# paths run, or answers an error reply when $HC_RPC_ERROR is set. `events` replays the event stream
# in $HC_EVENTS line by line, sleeping $HC_EVENTS_DELAY seconds before each line, and exits the way
# `hc events --json` does when the core stops.
set -u

if [ -n "${HC_FAIL:-}" ]; then
  echo "$HC_FAIL"
  exit 1
fi

case "${1:-}" in
  connect)
    request=$(cat)
    case $request in
      *terminal.list*) ;;
      *) echo "fake-hc: unexpected request: $request" >&2; exit 2 ;;
    esac
    if [ -n "${HC_RPC_ERROR:-}" ]; then
      printf '%s\n' '{"jsonrpc":"2.0","id":1,"error":{"code":-32601,"message":"unknown method"}}'
    else
      printf '{"jsonrpc":"2.0","id":1,"result":%s}\n' "$(jq -c . "${HC_FIXTURE:?HC_FIXTURE is not set}")"
    fi
    ;;
  events)
    if [ -z "${HC_EVENTS:-}" ]; then
      echo "fake-hc: HC_EVENTS is not set" >&2
      exit 2
    fi
    delay=${HC_EVENTS_DELAY:-0}
    first=1
    while IFS= read -r line; do
      if [ -z "$first" ]; then
        [ "$delay" = 0 ] || sleep "$delay" </dev/null
      fi
      first=
      printf '%s\n' "$line"
    done < "$HC_EVENTS"
    ;;
  *)
    echo "fake-hc: unsupported call: $*" >&2
    exit 2
    ;;
esac
