#!/bin/zsh
# Alfred UI pulse: rebuild the agent rows from `hc ls --json` as a JSON update action.
set -u
PATH="$HOME/.local/bin:/opt/homebrew/bin:$PATH"

out=$("${HC:-hc}" ls --json 2>&1) || {
  jq -cn --arg e "Herdr core is not running: $out" \
    '{update: {relayout: true, ids: {summary: {text: $e}, agents: {components: []}}}}'
  exit 0
}

jq -c --arg home "$HOME" '
  def rank: {"blocked":0,"working":1,"done":2,"idle":3}[. // ""] // 4;
  def symbol: {"blocked":"exclamationmark.octagon.fill","working":"hourglass",
               "done":"checkmark.circle.fill","idle":"moon.zzz.fill"}[. // ""] // "circle.dotted";
  def tint: {"blocked":"systemRedColor","working":"systemOrangeColor",
             "done":"systemGreenColor","idle":"systemGrayColor"}[. // ""] // "tertiaryLabelColor";
  [.terminals[]
    | select(.state == "live")
    | select((.agent // "?") | test("^(zsh|bash|sh|fish|nvim|vim)$") | not)]
  | to_entries | sort_by((.value.status | rank), .key) | map(.value) as $rows
  | ($rows | map(.status // "none") | group_by(.)
     | sort_by((.[0] | rank)) | map("\(length) \(.[0])") | join(" · ")) as $counts
  | {update: {relayout: true, ids: {
      summary: {text: (if ($rows | length) == 0 then "No Herdr agents running" else $counts end)},
      agents: {components: [$rows[] | {
        type: "view", layout: "border", padding: 6, spacing: 8, cornerradius: 6,
        background: "#80808018",
        events: [{triggers: "clicked",
                  action: {type: "script", src: "scripts/focus", args: .address, async: true}}],
        components: [
          {constraints: {region: "left"}, type: "imageview",
           image: {type: "symbol", src: (.status | symbol)}, contenttintcolour: (.status | tint)},
          {constraints: {region: "centre"}, type: "view", layout: "inline", direction: "vertical",
           spacing: 1, components: [
             {type: "label", text: "\(.name // .agent) — \(.where // "")"},
             {type: "label", colour: "secondaryLabelColor", font: {size: 11},
              text: "\(.status // "no status") · \(.agent) · turn \(.turn // 0) · \((.cwd // "") | sub("^" + $home; "~"))"}
           ]}
        ]}]}
    }}}' <<<"$out"
